#!/usr/bin/env bash
# Publish the camera MKVs into the mutable archive consumed by the viewer.
set -euo pipefail
shopt -s nullglob
umask 0022

# Keep the whole publisher (and every ffmpeg/ffprobe child it starts) in one
# bounded leaf even when it is launched directly.  A single leaf also makes
# the publisher lock below cover every media writer it owns.
if [[ ${TIMELAPSE_MEM_LIMITED:-} != 1 ]]; then
  exec env TIMELAPSE_MEM_LIMITED=1 MEM_POOL_SUB=timelapse-publish \
    MEM_POOL_SUB_MAX="${TIMELAPSE_MEM_LIMIT_BYTES:-4294967296}" \
    mem-limit-run "$0" "$@"
fi

video_root=$(cd -- "${1:?usage: publish VIDEO_ROOT}" && pwd)
# A developer invocation still publishes into its checkout-local ./www. The
# installed service supplies TIMELAPSE_ARCHIVE_ROOT instead, keeping media writes
# out of the immutable package store.
archive_root=${TIMELAPSE_ARCHIVE_ROOT:-$(pwd -P)/www}
artifact_root=
fps=24
frame_interval=300
declare -A delivery_filter=(
  [panorama]='scale_vaapi=w=2688:h=768:mode=hq:format=p010'
  [ptz]='scale_vaapi=w=1920:h=1088:mode=hq:format=p010'
)
declare -A delivery_aspect=(
  [panorama]='336:95'
  [ptz]='16:9'
)
av1_encode=(
  -c:v av1_vaapi -profile:v main -rc_mode QVBR -global_quality 121
  -b:v 40M -maxrate:v 40M -bufsize:v 40M
  -g "$fps" -force_key_frames 'expr:gte(t,n_forced*1)' -tag:v av01
)
declare -A month_ranges=()
declare -A day_ranges=()

for source in "$video_root"/panorama-????-??.mkv; do
  range=${source##*/panorama-}
  range=${range%.mkv}
  [[ -f "$video_root/ptz-$range.mkv" ]] && month_ranges[$range]=1
done
for source in "$video_root"/days/panorama-????-??-??.mkv; do
  range=${source##*/panorama-}
  range=${range%.mkv}
  [[ -f "$video_root/days/ptz-$range.mkv" ]] && day_ranges[$range]=1
done

ranges=()
for range in "${!month_ranges[@]}"; do ranges+=("$range"); done
for range in "${!day_ranges[@]}"; do
  [[ -v "month_ranges[${range:0:7}]" ]] || ranges+=("$range")
done
if ((${#ranges[@]})); then
  mapfile -t ranges < <(printf '%s\n' "${ranges[@]}" | sort)
fi

mkdir -p "$archive_root"
# Do not let two publishers replace the same single-file HLS object or JPEG at
# once. This is deliberately an archive-local lock: a different checkout may
# publish independently, while a Caddy reader is never touched.
exec {publish_lock}>"$archive_root/.publish.lock"
flock -n "$publish_lock" || {
  echo "another publisher owns $archive_root/.publish.lock" >&2
  exit 1
}
source_path() {
  if [[ $2 == ????-?? ]]; then
    printf '%s/%s-%s.mkv\n' "$video_root" "$1" "$2"
  else
    printf '%s/days/%s-%s.mkv\n' "$video_root" "$1" "$2"
  fi
}

epoch_for_range() {
  local day=$1
  [[ $day == ????-?? ]] && day+=-01
  date -u -d "$day 00:00:00" +%s
}

utc_for_epoch() {
  date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ
}

range_end_epoch() {
  local start_epoch=$1 source=$2 duration frames
  duration=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$source") || return
  frames=$(awk "BEGIN { printf \"%.0f\", $duration * $fps }") || return
  printf '%s\n' "$((start_epoch + frames * frame_interval))"
}

publish_video() {
  local camera=$1 range=$2 source=$3 base
  base="$artifact_root/video/$camera-$range"
  mkdir -p "$base"
  [[ -f "$base/stream.m3u8" && -f "$base/stream.mp4" && ! "$source" -nt "$base/stream.m3u8" ]] && return
  # Decode, high-quality-scale, and encode 10-bit AV1 on VAAPI for ordinary
  # playback, matching the fast renditions' delivery geometry and GOPs.
  ffmpeg -nostdin -y -hide_banner -loglevel warning \
    -vaapi_device /dev/dri/renderD128 -hwaccel vaapi -hwaccel_output_format vaapi \
    -i "$source" -map 0:v:0 -an \
    -vf "${delivery_filter[$camera]}" \
    "${av1_encode[@]}" -aspect:v "${delivery_aspect[$camera]}" \
    -f hls -hls_time 1 -hls_segment_type fmp4 \
    -hls_flags independent_segments+single_file -hls_playlist_type vod \
    -hls_segment_filename "$base/stream.mp4" "$base/stream.m3u8"
}

publish_fast_video() {
  local camera=$1 range=$2 source=$3 stride=$4
  local base
  base="$artifact_root/video/$camera-$range/x$stride"
  mkdir -p "$base"
  [[ -f "$base/stream.m3u8" && -f "$base/stream.mp4" && ! "$source" -nt "$base/stream.m3u8" ]] && return
  # Frame selection makes stream-copy impossible.  Use the same high-quality,
  # 10-bit delivery geometry and hardware AV1 settings as ordinary playback.
  ffmpeg -nostdin -y -hide_banner -loglevel warning \
    -vaapi_device /dev/dri/renderD128 -hwaccel vaapi -hwaccel_output_format vaapi \
    -i "$source" -map 0:v:0 -an \
    -vf "select=not(mod(n\\,$stride)),setpts=N/(${fps}*TB),${delivery_filter[$camera]}" \
    -r "$fps" "${av1_encode[@]}" -aspect:v "${delivery_aspect[$camera]}" \
    -f hls -hls_time 1 -hls_segment_type fmp4 \
    -hls_flags independent_segments+single_file -hls_playlist_type vod \
    -hls_segment_filename "$base/stream.mp4" "$base/stream.m3u8"
}

publish_thumbnails() {
  local camera=$1 source=$2 start_epoch=$3 end_epoch=$4
  local utc_day hour_epoch frame_index seconds hour tier output temporary next_day_epoch
  local -a command=() missing=()
  utc_day=$(date -u -d "@$start_epoch" +%F)
  while :; do
    for hour in 00 06 12 18; do
      hour_epoch=$(date -u -d "$utc_day $hour:00:00Z" +%s)
      (( hour_epoch >= start_epoch && hour_epoch < end_epoch )) || continue
      (( (hour_epoch - start_epoch) % frame_interval == 0 )) || {
        echo "thumbnail time is not an archive frame: ${utc_day}T${hour}:00Z" >&2
        exit 1
      }
      frame_index=$(((hour_epoch - start_epoch) / frame_interval))
      seconds=$(awk "BEGIN { printf \"%.6f\", $frame_index / $fps }")
      missing=()
      for tier in 90 180 360; do
        output="$artifact_root/thumbnails/h$tier/$camera-$utc_day-${hour}Z.jpg"
        [[ -e $output && ! "$source" -nt "$output" ]] || missing+=("$tier:$output")
      done
      if ((${#missing[@]})); then
        for tier in "${missing[@]}"; do mkdir -p "$(dirname -- "${tier#*:}")"; done
        temporary=$(mktemp -d "$artifact_root/.jpeg.XXXXXX")
        # Decode and scale on VAAPI.  JPEG itself is software encoded because
        # the Radeon exposes no JPEG encoder.  Deliberately keep the ASS
        # metadata stream out: its NODATA text remains the viewer's VTT
        # overlay, while the video frame's own held/greyed pixels are exact.
        command=(ffmpeg -nostdin -n -hide_banner -loglevel warning
          -vaapi_device /dev/dri/renderD128 -hwaccel vaapi -hwaccel_output_format vaapi
          -ss "$seconds" -i "$source" -an
          -filter_complex '[0:v]split=3[a][b][c];[a]scale_vaapi=w=-2:h=90:format=nv12,hwdownload,format=nv12[v90];[b]scale_vaapi=w=-2:h=180:format=nv12,hwdownload,format=nv12[v180];[c]scale_vaapi=w=-2:h=360:format=nv12,hwdownload,format=nv12[v360]')
        for tier in 90 180 360; do
          command+=(-map "[v$tier]" -frames:v 1 -q:v 3 -update 1 "$temporary/h$tier.jpg")
        done
        "${command[@]}"
        chmod 0644 "$temporary"/h{90,180,360}.jpg
        for tier in 90 180 360; do
          mv -f "$temporary/h$tier.jpg" "$artifact_root/thumbnails/h$tier/$camera-$utc_day-${hour}Z.jpg"
        done
        rm -rf "$temporary"
      fi
    done
    utc_day=$(date -u -d "$utc_day +1 day" +%F)
    next_day_epoch=$(date -u -d "$utc_day 00:00:00Z" +%s)
    (( next_day_epoch < end_epoch )) || break
  done
}

publish_subtitles() {
  # The panorama and PTZ subtitle timelines are aligned, so publish one small
  # range-level sidecar from panorama rather than duplicating it per camera.
  local range=$1 source=$2 output temporary
  output="$artifact_root/subtitles/$range.vtt"
  [[ -f "$output" && ! "$source" -nt "$output" ]] && return
  mkdir -p "$(dirname -- "$output")"
  temporary=$(mktemp "$artifact_root/subtitles/.$range.XXXXXX")
  {
    printf 'WEBVTT\n\n'
    # ASS's Outage style is the source-of-truth signal for NODATA frames.
    # Keep its text and centisecond cue boundaries, but omit ordinary Date
    # labels so consumers only have to process exceptional intervals.
    ffmpeg -nostdin -v error -i "$source" -map 0:s:0 -c:s copy -f ass - |
      awk '
        function timestamp(ass, part) {
          split(ass, part, /[:.]/)
          return sprintf("%02d:%02d:%02d.%03d", part[1], part[2], part[3], part[4] * 10)
        }
        /^Dialogue: / {
          line = substr($0, 11)
          fields = split(line, field, ",")
          if (field[4] != "Outage") next
          text = field[10]
          for (i = 11; i <= fields; i++) text = text "," field[i]
          gsub(/\{[^}]*\}/, "", text)
          gsub(/\\\\[Nn]/, "\n", text)
          printf "%s --> %s\n%s\n\n", timestamp(field[2]), timestamp(field[3]), text
        }
      '
  } >"$temporary"
  chmod 0644 "$temporary"
  mv -f "$temporary" "$output"
}

remove_superseded_daily() {
  local month=$1 panorama_daily day ptz_daily
  # A completed monthly range supersedes daily inputs and derived assets only
  # after its replacement is already visible through catalog.json.
  for panorama_daily in "$video_root/days/panorama-$month"-??.mkv; do
    day=${panorama_daily##*/panorama-}
    ptz_daily="$video_root/days/ptz-$day"
    [[ -f "$ptz_daily" ]] && rm -f -- "$panorama_daily" "$ptz_daily"
  done
  rm -rf -- "$archive_root/ranges/$month"-??
}

declare -A catalog_entries=()
declare -A desired_ranges=()
catalog=
stage=
cleanup_catalog_staging() {
  rm -f -- "$catalog"
  [[ -z $stage ]] || rm -rf -- "$stage"
}
trap cleanup_catalog_staging EXIT

load_catalog() {
  local id entry
  [[ -f "$archive_root/catalog.json" ]] || return 0
  while IFS=$'\t' read -r id entry; do
    catalog_entries[$id]=$entry
  done < <(
    awk '
      match($0, /\{"id":"[0-9]{4}-[0-9]{2}(-[0-9]{2})?","start":"[^"]+","end":"[^"]+"\}/) {
        entry = substr($0, RSTART, RLENGTH)
        match(entry, /"id":"([^"]+)"/, value)
        printf "%s\t%s\n", value[1], entry
      }
    ' "$archive_root/catalog.json"
  )
}

publish_catalog() {
  local id separator=
  local -a ids=("${!catalog_entries[@]}")
  if ((${#ids[@]})); then mapfile -t ids < <(printf '%s\n' "${ids[@]}" | sort); fi
  catalog=$(mktemp "$archive_root/.catalog.XXXXXX")
  {
    printf '{\n  "cameras": ["panorama", "ptz"],\n  "ranges": ['
    for id in "${ids[@]}"; do
      printf '%s\n    %s' "$separator" "${catalog_entries[$id]}"
      separator=,
    done
    printf '\n  ]\n}\n'
  } >"$catalog"
  chmod 0644 "$catalog"
  mv -f "$catalog" "$archive_root/catalog.json"
  catalog=
}

mkdir -p "$archive_root/ranges"
load_catalog

for range in "${ranges[@]}"; do
  desired_ranges[$range]=1
  start_epoch=$(epoch_for_range "$range")
  panorama_source=$(source_path panorama "$range")
  ptz_source=$(source_path ptz "$range")
  range_dir="$archive_root/ranges/$range"
  if [[ -f "$range_dir/.complete" ]]; then
    read -r end_epoch <"$range_dir/.complete"
  else
    [[ ! -e $range_dir ]] || {
      echo "incomplete range already exists: $range_dir" >&2
      exit 1
    }
    stage=$(mktemp -d "$archive_root/.range-$range.XXXXXX")
    artifact_root=$stage
    end_epoch=$(range_end_epoch "$start_epoch" "$panorama_source")
    publish_video panorama "$range" "$panorama_source"
    publish_video ptz "$range" "$ptz_source"
    publish_fast_video panorama "$range" "$panorama_source" 6
    publish_fast_video panorama "$range" "$panorama_source" 36
    publish_fast_video ptz "$range" "$ptz_source" 6
    publish_fast_video ptz "$range" "$ptz_source" 36
    publish_subtitles "$range" "$panorama_source"
    publish_thumbnails panorama "$panorama_source" "$start_epoch" "$end_epoch"
    publish_thumbnails ptz "$ptz_source" "$start_epoch" "$end_epoch"
    printf '%s\n' "$end_epoch" >"$stage/.complete"
    chmod 0644 "$stage/.complete"
    chmod 0755 "$stage"
    mv -T "$stage" "$range_dir"
    stage=
  fi
  if [[ $range == ????-?? ]]; then
    for id in "${!catalog_entries[@]}"; do
      [[ $id == "$range"-?? ]] && unset "catalog_entries[$id]"
    done
  fi
  printf -v entry '{"id":"%s","start":"%s","end":"%s"}' "$range" "$(utc_for_epoch "$start_epoch")" "$(utc_for_epoch "$end_epoch")"
  catalog_entries[$range]=$entry
  publish_catalog
  [[ $range == ????-?? ]] && remove_superseded_daily "$range"
done
for id in "${!catalog_entries[@]}"; do
  [[ -v "desired_ranges[$id]" ]] || unset "catalog_entries[$id]"
done
publish_catalog
